# Postgres
DATABASE_URL=postgres://radar:radar@localhost:5432/radar

# GitHub API (required) — a PAT or GitHub App token with public read access
GITHUB_TOKEN=

# GH Archive: "dumps" (download hourly files) or "bigquery"
GHARCHIVE_MODE=dumps
GCP_PROJECT_ID=

# Optional connectors — leave the flag false to disable
OSSINSIGHT_ENABLED=true
TRENDSHIFT_ENABLED=false
TRENDSHIFT_API_KEY=
GITHUB_EXPLORER_ENABLED=false

# API
API_PORT=4000

# Postgres host port for docker compose (change if 5432 is taken by another local Postgres)
POSTGRES_PORT=5432
# Integration tests; they skip cleanly when this is unset or unreachable
TEST_DATABASE_URL=postgres://radar:radar@localhost:5432/radar

# --- v2: MCP server (apps/mcp) ---
# Required, at least 32 characters. Readers send it as `Authorization: Bearer <token>`. Generate: openssl rand -hex 32
MCP_TOKEN=
# Listen port (default 8080; Railway sets it)
PORT=8080
# Folder holding the idea files (default: the repo's ideas/ folder). Use an absolute path.
IDEAS_DIR=
