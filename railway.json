{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @idea-radar/mcp... build",
    "watchPatterns": [
      "/ideas/**",
      "/apps/mcp/**",
      "/packages/ideas/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/tsconfig.base.json",
      "/railway.json"
    ]
  },
  "deploy": {
    "startCommand": "node apps/mcp/dist/index.js",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
