{
  "name": "@idea-radar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "dev": "tsx --conditions=source src/index.ts",
    "test": "tsx --conditions=source --test \"src/**/*.test.ts\""
