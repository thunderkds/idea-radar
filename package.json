{
  "name": "idea-radar",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Claude-researched project ideas stored as files in git, served by a read-only MCP server.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter \"./packages/**\" build && pnpm -r typecheck",
    "lint": "pnpm -r lint && eslint scripts eslint.config.js",
    "format:check": "prettier --check packages apps scripts eslint.config.js",
    "test": "pnpm -r test && tsx --conditions=source --test \"scripts/**/*.test.ts\"",
    "ideas:check": "pnpm --filter @idea-radar/ideas check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.7.0",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=20"
  }
}
